# ==========================================
# Forma — AI Landing Page Studio Environment
# ==========================================

# 1. Database Configuration (MongoDB Atlas or local)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/forma?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/forma

# 2. Google Gemini API (Official Google Gen AI SDK)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Supported models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# 3. Media Storage (Cloudinary - Optional, persistent local storage fallback active)
# Obtain credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 5. Security Secrets
SESSION_SECRET=forma_super_secure_development_session_secret_2026_at_least_32_chars
